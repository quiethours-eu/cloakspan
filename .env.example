# Secure AI Gateway production configuration.
#
# Copy this file to .env and fill every required value. Blank required values
# deliberately make `docker compose config` fail. Never commit .env.

# Format: sgw_live_<at-least-32-random-bytes>:tenant:application
# Generate the random part with: openssl rand -base64 32
SAG_API_KEYS=

# Generate independently with: openssl rand -hex 32
SAG_VAULT_KEY=
SAG_TOKEN_KEY=

# OpenAI-compatible /v1 base URLs. The bundled policy can select both.
# The local URL may be Ollama, vLLM, or another private compatible endpoint.
SAG_EXTERNAL_BASE_URL=
SAG_EXTERNAL_API_KEY=
SAG_EXTERNAL_MODEL=
SAG_LOCAL_BASE_URL=
SAG_LOCAL_MODEL=

# Strongly recommended: comma-separated hostnames used above.
SAG_EGRESS_ALLOWLIST=

SAG_BIND_HOST=127.0.0.1
SAG_PORT=8080
SAG_VAULT_TTL_SECONDS=3600
SAG_MAX_INPUT_CHARS=65536
SAG_MAX_REQUEST_BYTES=1048576
SAG_REQUEST_TIMEOUT_SECONDS=120
SAG_LOG_LEVEL=INFO

# Optional detection configuration.
SAG_NER_MODEL_PATH=
SAG_DICTIONARY_TERMS=
SAG_CUSTOM_PATTERNS=
SAG_BLOCK_MIXED_SCRIPT=false
SAG_TRUST_ENV_PROXY=false
SAG_EGRESS_ALLOW_PRIVATE=false
