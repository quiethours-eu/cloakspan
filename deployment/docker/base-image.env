# The container base image, pinned by digest for release builds.
#
# A tag is mutable. `python:3.12-alpine3.23` is a different image today than
# it was last month, so a build that references it is not reproducible and an
# SBOM taken from it describes something that no longer exists. For a product
# whose output is evidence, that is not a small problem.
#
# Development builds may use the tag; **release builds must use the digest**,
# and `make release-image` refuses to run without one.
#
# To refresh (needs registry access):
#
#     make pin-base-image
#
# which resolves the tag and rewrites BASE_DIGEST below. Review the diff: a
# changed digest means the base image moved, and the vulnerability scan should
# be re-read before the release goes out.

BASE_IMAGE=python:3.12-alpine3.23

# Resolved against the registry by scripts/pin_base_image.py.
BASE_DIGEST=sha256:33a47b0a92c0766bdd77cd82bbaa4c320ce48db01a2bfe1782920ca7a16e3744

# When the digest was resolved, and by what.
BASE_PINNED_ON=2026-10-02
BASE_PINNED_BY=codex-release-preparation
